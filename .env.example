# Local-only Phase 1. No credentials are needed.
SITE_URL=http://127.0.0.1:8787
# Future phases: configure only after approval. Never put tokens in NEXT_PUBLIC_*.
# MEDIA_BASE_URL=https://media.example.com
# SANITY_PROJECT_ID=
# SANITY_DATASET=

# Admin API authentication. Configure only after Access setup is approved.
# Server-only; never prefix these names with NEXT_PUBLIC_. No local auth bypass.
# ACCESS_ISSUER=https://your-team.cloudflareaccess.com
# ACCESS_AUDIENCE=your-access-application-audience
# ADMIN_EMAILS=administrator@example.com
# ADMIN_ORIGIN=https://your-approved-admin-origin.example

# Server-side content and direct upload: requires separate credential authorization.
# SANITY_WRITE_TOKEN=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# UPLOAD_QUOTA_BYTES=
# Dedicated PC processor credential: 32 cryptographically random bytes as hex.
# Keep only in server secrets and private PC configuration, never browser storage.
# PROCESSOR_TOKEN=
# PC-only: approved backend origin and an existing private directory outside Git,
# public folders, and automatic cloud-sync folders. See docs/LOCAL-PROCESSOR.md.
# PROCESSOR_ORIGIN=
# PROCESSOR_WORK_DIR=
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
# PC-only native executables; not needed by the deployed Worker.
# FFMPEG_PATH=
# FFPROBE_PATH=
